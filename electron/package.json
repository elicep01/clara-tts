{
  "name": "clara-electron",
  "productName": "Clara",
  "version": "1.0.0",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "icons": "node scripts/generate-app-icons.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:main && npm run build:preload",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "quick": "env -u ELECTRON_RUN_AS_NODE electron .",
    "watch": "tsc -p tsconfig.main.json --watch & tsc -p tsconfig.preload.json --watch",
    "dev": "npm run build && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "canvas": "^2.11.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.1"
  }
}
