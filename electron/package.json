{
  "name": "clara-electron",
  "version": "1.0.0",
  "description": "Clara - Your Reading Companion (Electron)",
  "main": "dist/main/index.js",
  "author": "Clara Team",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && npm run build:preload && env -u ELECTRON_RUN_AS_NODE electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:main && npm run build:preload",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "quick": "env -u ELECTRON_RUN_AS_NODE electron .",
    "watch": "tsc -p tsconfig.main.json --watch & tsc -p tsconfig.preload.json --watch",
    "rebuild": "electron-rebuild",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "canvas": "^2.11.2",
    "electron": "^28.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.clara.reading",
    "productName": "Clara",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
